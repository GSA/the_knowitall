{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowitall.spud-artifacts/v1/artifact-query-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "request_id", "project_id", "repository_id", "selector", "query"],
  "properties": {
    "contract": {"const": "knowitall.spud-artifacts/v1"},
    "request_id": {"$ref": "#/$defs/identity"},
    "project_id": {"$ref": "#/$defs/identity"},
    "repository_id": {"$ref": "#/$defs/identity"},
    "selector": {"type": "object", "additionalProperties": false, "required": ["mode", "bundle_id"], "properties": {"mode": {"const": "bundle"}, "bundle_id": {"$ref": "#/$defs/identity"}}},
    "query": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "name", "match"], "properties": {"kind": {"const": "symbol"}, "name": {"$ref": "#/$defs/identity"}, "match": {"enum": ["exact", "normalized"]}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "symbol_id", "direction", "relations"], "properties": {"kind": {"const": "relationships"}, "symbol_id": {"$ref": "#/$defs/identity"}, "direction": {"enum": ["incoming", "outgoing"]}, "relations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identity"}}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "path"], "properties": {"kind": {"const": "artifact_path"}, "path": {"$ref": "#/$defs/path"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"const": "narrative_search"}, "text": {"$ref": "#/$defs/identity"}}}
    ]},
    "continuation": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "identity": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^/]+(?:/[^/]+)*$"}
  }
}
